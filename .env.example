# Ключ авторизации GigaChat (Authorization Key) из личного кабинета.
# В чат и в git его отправлять не нужно.
GIGACHAT_CREDENTIALS=

# Версия доступа. Пустое значение = GIGACHAT_API_PERS (физическое лицо).
# Для компании: GIGACHAT_API_B2B или GIGACHAT_API_CORP.
GIGACHAT_SCOPE=

# Имя модели. Пустое значение = GigaChat-2.
GIGACHAT_MODEL=

# Проверка сертификата: true или false.
# Пустое значение отключает проверку, чтобы локальный запуск не падал
# на сертификате Минцифры. Подробности — в README.
GIGACHAT_VERIFY_SSL_CERTS=

# Путь к файлу корневого сертификата. Можно оставить пустым.
GIGACHAT_CA_BUNDLE_FILE=

# Входящий вебхук Битрикс24 с правами CRM, задач и уведомлений.
# Полный адрес вида https://портал.bitrix24.ru/rest/1/код/
# В чат и в git его отправлять не нужно.
B24_URL=
